# Chép thành .env (cùng thư mục docker-compose.yml) rồi sửa. File .env không được commit.

# Khóa ký đăng nhập: đổi thành chuỗi ngẫu nhiên khi cho người khác dùng
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me

# Link trong email đặt lại mật khẩu trỏ về đây
APP_URL=http://localhost:3000

# Model AI tóm tắt (Ollama)
LLM_MODEL=qwen2.5:3b

# Gửi email thật qua Gmail (để trống thì email được lưu ở backend/outbox/*.eml)
# SMTP_PASSWORD là App Password của Gmail, không phải mật khẩu đăng nhập
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Chỉ bật khi web chạy qua HTTPS: cookie đăng nhập chỉ gửi qua kết nối mã hóa
COOKIE_SECURE=false
